PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://<your-neon-host>/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=<your-neon-password>
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_HIBERNATE_DDL_AUTO=update
PROHIRE_JWT_SECRET=super-secret-key-that-is-at-least-32-characters-long
NEON_AUTH_URL=https://<your-neon-auth-host>/neondb/auth
NEON_JWKS_URI=https://<your-neon-auth-host>/neondb/auth/.well-known/jwks.json
NEON_REST_URL=https://<your-neon-rest-host>/neondb/rest/v1
AWS_ENDPOINT_URL_S3=https://<your-neon-s3-endpoint>.storage.c-7.us-east-2.aws.neon.tech
AWS_ACCESS_KEY_ID=<your-neon-s3-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-neon-s3-secret-access-key>
AWS_REGION=us-east-2

